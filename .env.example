# ===== 大模型（一期用 DeepSeek）=====
# 必填：去 https://platform.deepseek.com 申请
LLM_API_KEY=sk-在这里填你的DeepSeek密钥

# 以下都有默认值，一般不用改
# 这两个值是实测可用的；该端点上目前的模型是 deepseek-flash 与 deepseek-v4-pro
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.7

# ===== 数据库 =====
# 一期默认 SQLite，什么都不用填。
# 留空 = 本机窗口版用 instance/crew_v4_win.sqlite3
#        （`run_web.py` 也走同一个配置类，所以两个入口看的是同一个库）
#        注意：`app/config.py` 的基类默认是 crew_v4.sqlite3，
#        而本机窗口版通过 `app/config_desktop.py` 覆盖成了带 _win 的那个。
DATABASE_URL=

# 将来切 MySQL 时，把上面留空改为下面这行（并取消 requirements.txt 里 PyMySQL 的注释）：
# DATABASE_URL=mysql+pymysql://root:你的密码@127.0.0.1:3306/crew_v4?charset=utf8mb4

# ===== 运行时 =====
# 同时执行的教学回合上限（也是 API 成本护栏）。
# 注意：回合后的"复盘 + 学习信号观察"走另一个容量为 1 的线程池，
# 所以总并发上限是 TURN_MAX_WORKERS + 1（见 app/services/runtime.py）。
TURN_MAX_WORKERS=2
# 每回合装配进提示词的最近对话轮数（1 轮 = 你一句 + 讲师一句）
CONTEXT_RECENT_TURNS=6
# 一个任务默认最多跑多久（秒）。超时会被自动中止并给出提示，
# 而不是让界面永远停在"正在讲"。实际会按任务类型覆盖：
#   讲授 900s / 大纲 1800s / 图解 300s / 问卷解析 300s（见 app/api/_common.py）
TURN_TIMEOUT_SECONDS=600
# Flask 端口
PORT=5000

# ===== 讲义保存（工作区）=====
# 每轮授课与图解会自动写成 Markdown 存到这里，不需要手动导出。
# 留空 = 项目下的 notes/
# 也可以指定别处，例如：LECTURE_DIR=D:\我的讲义
LECTURE_DIR=

# ===== 数据放哪（一般不用改）=====
# 数据库、日志、讲义、界面偏好、窗口位置默认都在**项目目录**里——这样才"拷走
# 整个文件夹就能用"。装成程序之后（程序在 Program Files 下是只读的）要用环境
# 变量 CREW_HOME 把数据指到用户目录：
#     set CREW_HOME=%LOCALAPPDATA%\CREW
# 便携用法**不设它**就对了：不设的时候行为与从前一字不差。
# 写在这里（.env）也认，但它是"这台机器上数据放哪"，通常由启动器去设。

# 单次模型调用的超时（秒）。上游"连接不断、数据不来"时，没有它就会永远停在"讲课中"。
# 默认 180 秒；调大只会让卡住时等更久，一般不用改。
LLM_TIMEOUT=180
